# Local deployment defaults. Copy to .env and adjust on the N95.
LUMINEXT_BIND=127.0.0.1
LUMINEXT_MEDIA_IP=127.0.0.1
LUMINEXT_SECURE_COOKIES=0
# Set the numeric groups from the actual /dev/dri and video group on your host.
RENDER_GID=109
VIDEO_GID=44
# Used only when cloud HTTPS deployment is commissioned.
LUMINEXT_DOMAIN=console.example.com
